# Copy this file to .env and adjust. Never commit the real .env.

# --- PostgreSQL container (used by docker compose) ---
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=change-me

# --- Application (used when running natively with `mvn spring-boot:run`) ---
DB_URL=jdbc:postgresql://localhost:5432/tasktracker
DB_USERNAME=tasktracker
DB_PASSWORD=change-me

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRATION_MINUTES=60

SERVER_PORT=8080